-- ========================================================
-- HIEPEVADE - AUTO JUMP / BHOP (FIXED MANUAL JUMP CONFLICT)
-- ========================================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
if not PlayerGui then return end

if PlayerGui:FindFirstChild("EvadeAutoJumpGui") then
	PlayerGui.EvadeAutoJumpGui:Destroy()
end

local SG = Instance.new("ScreenGui")
SG.Name = "EvadeAutoJumpGui"
SG.ResetOnSpawn = false
SG.Parent = PlayerGui

-- NÚT TRÒN MINI KÉO RÊ DÀNH CHO AUTO JUMP
local JumpButton = Instance.new("TextButton")
JumpButton.Size = UDim2.new(0, 50, 0, 50)
JumpButton.Position = UDim2.new(0.85, 0, 0.35, 0)
JumpButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
JumpButton.Text = "BHOP\n[ OFF ]"
JumpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
JumpButton.TextSize = 9
JumpButton.Font = Enum.Font.SourceSansBold
JumpButton.Active = true
JumpButton.Draggable = true
JumpButton.Parent = SG

Instance.new("UICorner", JumpButton).CornerRadius = UDim.new(1, 0)
local CircleStroke = Instance.new("UIStroke", JumpButton)
CircleStroke.Color = Color3.fromRGB(255, 255, 255)
CircleStroke.Thickness = 1.5

local autoJumpActive = false

JumpButton.MouseButton1Click:Connect(function()
	autoJumpActive = not autoJumpActive
	if autoJumpActive then
		JumpButton.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
		JumpButton.Text = "BHOP\n[ ON ]"
		CircleStroke.Color = Color3.fromRGB(100, 255, 100)
	else
		JumpButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		JumpButton.Text = "BHOP\n[ OFF ]"
		CircleStroke.Color = Color3.fromRGB(255, 255, 255)
	end
end)

-- VÒNG LẶP AUTO JUMP BHOP (KHÔNG BỊ XUNG ĐỘT NÚT NHẢY TAY)
task.spawn(function()
	local canJumpAgain = true
	
	while true do
		task.wait(0.02) -- Tăng độ trễ nhẹ để tránh ghi đè nhịp nhảy thủ công
		
		if autoJumpActive then
			pcall(function()
				local char = LocalPlayer.Character
				if char then
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					local hrp = char:FindFirstChild("HumanoidRootPart")
					
					if humanoid and hrp and humanoid.Health > 0 then
						local isMoving = humanoid.MoveDirection.Magnitude > 0.1
						local isOnGround = humanoid.FloorMaterial ~= Enum.Material.Air
						
						-- Chỉ kích hoạt nhảy đúng thời điểm vừa tiếp đất và đang di chuyển
						if isMoving and isOnGround and canJumpAgain then
							canJumpAgain = false
							humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
							task.wait(0.1)
							canJumpAgain = true
						end
					end
				end
			end)
		else
			canJumpAgain = true
		end
	end
end)
